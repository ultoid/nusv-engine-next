{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "resolveJsonModule": true, "allowJs": true, "strict": true, "noEmit": true,
    "jsx": "react-jsx", "skipLibCheck": true, "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
