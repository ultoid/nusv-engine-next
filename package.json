{
  "name": "nusv-engine-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": ".electron-dist/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node scripts/smoke.cjs",
    "test": "npm run build:electron && node --test",
    "balance": "npm run build:electron && node scripts/balance-report.mjs",
    "licenses": "node scripts/license-report.cjs",
    "package:win": "npm run build && npm run licenses && node scripts/package-win.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "release:verify": "npm test && npm run smoke && npm run package:win && npm run verify:package"
  },
  "allowScripts": {
    "electron@45.4.1": true
  },
  "dependencies": {
    "pixi.js": "^8.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.8"
  }
}
